Arvvar* arvv_cria(char c){
    Arvvar* p = (Arvvar*)malloc(sizeof(Arvvar));
    p->info = c;
    p->prim = NULL;
    p->prox = NULL;
    return p;
}
void arvv_insere(Arvvar* a, Arvvar* sa){
    sa->prox = a->prim;
    a->prim = sa;
}
void arvv_imprime(Arvvar* a){
    if(a != NULL){
        printf("<%c\n", a->info);
        for(Arvvar* p = a->prim; p != NULL; p = p->prox)
            arvv_imprime(p);
        printf(">");
    }
}
int arvv_pertence(Arvvar* a, char c){
    if(a->info == c)
        return 1;
    else
        for(Arvvar* p = a->prim; p != NULL; p = p->prox)
            if(arvv_pertence(p))
                return 1;
    return 0;
}
void arvv_libera(Arvvar* a){
    Arvvar* p = a->prim;
    while(p != NULL){
        Arvvar* t = p->prox;
        arvv_libera(p);
        p = t;
    }
    free(a);
}
int arvv_altura(Arvvar* a){
    if(a == NULL)
        return -1;
    int max = 0;
    for(Arvvar* p = a->prim; p != NULL; p = p->prox){
        int alt = arvv_altura(p->prim);
        if(alt > max)
            max = alt;
    }

    return max + 1;
}

